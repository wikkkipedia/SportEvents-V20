# SportEvents coding rules: SR01 V20.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:error
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_primary_constructors = false:silent
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.CS1591.severity = warning
# The exercise files do not require corporate file header copyright (SR01 A-11).
dotnet_diagnostic.SA1633.severity = none
# This class-library project deliberately keeps System using statements inside the namespace policy (SR01 A-12).
dotnet_diagnostic.SA1200.severity = none
# Explicit documentation is enforced by CS1591; StyleCop summary duplication is avoided.
dotnet_diagnostic.SA1600.severity = none

# Project-specific analyzer exceptions (documented decision; strict build remains enabled).
# Related domain records/interfaces are grouped into small cohesive source files.
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none
# Public API summaries are required by CS1591; parameter/return text is optional here.
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1616.severity = none
# Keep source-level ordering and multiline formatting consistent with existing style.
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1117.severity = none
# Instance-level domain service APIs deliberately allow injected/testable collaborators.
dotnet_diagnostic.CA1822.severity = none
# Static named factories on generic Result<T> are intentional and used throughout the API.
dotnet_diagnostic.CA1000.severity = none
# Explicit argument errors are retained where a more descriptive message is useful.
dotnet_diagnostic.CA1512.severity = none

# xUnit names use Method_Situation_ExpectedResult, as explicitly required in Lab 7.
[SportEvents.Tests/*.cs]
dotnet_diagnostic.CA1707.severity = none
# Small inline test inputs are intentionally allocated per test for independence.
dotnet_diagnostic.CA1861.severity = none

# The console composition root uses interface types intentionally for DI.
[SportEvents.Console/*.cs]
dotnet_diagnostic.CA1859.severity = none

# C# IDE style prefers unqualified member access; avoid conflicting StyleCop SA1101.
[*.cs]
dotnet_diagnostic.SA1101.severity = none
